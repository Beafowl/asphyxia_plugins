//DATA//
  scores: DB.Find(refid, { collection: 'music' })
-
div
  .buttons.has-addons.mb-4
    button.button.is-link#method-tachi-btn
      span.icon
        i.mdi.mdi-swap-horizontal
      span Kamaitachi
    button.button#method-flower-btn
      span.icon
        i.mdi.mdi-flower
      span Project Flower
    button.button#method-csv-btn
      span.icon
        i.mdi.mdi-file-delimited
      span E-Amusement CSV
    button.button#method-server-btn
      span.icon
        i.mdi.mdi-database-import
      span Another Server

  #method-tachi
    #tachi-controller-warning.notification(style="background-color:rgba(183,149,19,0.25);color:#f5e6ab;border-left:4px solid #b79513;")
      button.delete(onclick="document.getElementById('tachi-controller-warning').style.display='none';localStorage.setItem('tachi-warning-dismissed','1');")
      p
        strong Scores must be achieved on an arcade-size controller!
      p Playing on other input devices (like a keyboard) will get you in trouble.
      p
        strong A Pocket-Voltex DOES NOT count as an #[em ARCADE SIZE] controller!

    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-download
          | Import from Tachi
      .card-content
        .content
          p Pull your personal bests from #[a(href="https://kamai.tachi.ac" target="_blank") Kamaitachi] into Asphyxia.

        #tachi-status
          .notification.is-info.is-light
            span.icon
              i.mdi.mdi-loading.mdi-spin
            |  Checking Tachi authorization status...

        #tachi-not-authorized(style="display:none")
          .notification(style="background-color:rgba(255,183,77,0.15);color:#ffb74d;")
            p You are not yet authorized with Tachi. Click the button below to connect your account.
          .field
            button.button.is-link#tachi-authorize-btn
              span.icon
                i.mdi.mdi-link
              span Authorize with Tachi

        #tachi-authorized(style="display:none")
          .level
            .level-left
              .level-item
                span.tag.is-success.is-medium
                  span.icon
                    i.mdi.mdi-check-circle
                  span Connected to Tachi
          .field.is-grouped.is-grouped-multiline
            .control
              button.button.is-link#tachi-import-btn
                span.icon
                  i.mdi.mdi-download
                span Import from Tachi
            .control
              button.button.is-info#tachi-sync-btn(data-tooltip="Import from Tachi, then export local scores to Tachi")
                span.icon
                  i.mdi.mdi-sync
                span Synchronize
            .control
              button.button.is-danger.is-outlined#tachi-disconnect-btn
                span.icon
                  i.mdi.mdi-link-off
                span Disconnect

        #tachi-result(style="display:none")
          .card.mt-4
            .card-header
              p.card-header-title Result
            .card-content
              #tachi-result-content

    #tachi-pb-lists(style="display:none;margin-top:1.5rem")
      .card
        .card-header
          p.card-header-title
            span.icon
              i.mdi.mdi-format-list-numbered
            | Best 50 Scores
        .card-content
          .columns
            .column
              h5.title.is-5 Asphyxia Best 50
              #asphyxia-pb-table
                .has-text-centered
                  span.icon
                    i.mdi.mdi-loading.mdi-spin
                  |  Loading...
            .column
              h5.title.is-5 Tachi Best 50
              #tachi-pb-table
                .has-text-centered
                  span.icon
                    i.mdi.mdi-loading.mdi-spin
                  |  Loading...

  #method-flower(style="display:none")
    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-flower
          | Import from Project Flower
      .card-content
        .content
          p Import your SDVX scores from #[a(href="https://projectflower.eu" target="_blank") Project Flower].

        #flower-status
          .notification.is-info.is-light
            span.icon
              i.mdi.mdi-loading.mdi-spin
            |  Checking Project Flower authorization status...

        #flower-not-authorized(style="display:none")
          .notification(style="background-color:rgba(255,183,77,0.15);color:#ffb74d;")
            p You are not yet authorized with Project Flower. Click the button below to connect your account.
          .field
            button.button.is-link#flower-authorize-btn
              span.icon
                i.mdi.mdi-link
              span Authorize with Project Flower

        #flower-authorized(style="display:none")
          .level
            .level-left
              .level-item
                span.tag.is-success.is-medium
                  span.icon
                    i.mdi.mdi-check-circle
                  span Connected to Project Flower
          .field.is-grouped.is-grouped-multiline
            .control
              button.button.is-link#flower-import-btn
                span.icon
                  i.mdi.mdi-download
                span Import Scores
            .control
              button.button.is-danger.is-outlined#flower-disconnect-btn
                span.icon
                  i.mdi.mdi-link-off
                span Disconnect

        #flower-result(style="display:none")
          .card.mt-4
            .card-header
              p.card-header-title Result
            .card-content
              #flower-result-content

  #method-csv(style="display:none")
    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-file-delimited
          | Import from E-Amusement CSV
      .card-content
        .content
          p Import scores from an E-Amusement CSV export file (score.csv). Song names will be matched against the song database.

        #csv-step-1
          .field
            .file.has-name.is-fullwidth
              label.file-label
                input.file-input(type="file" id="csv-file-input" accept=".csv")
                span.file-cta
                  span.file-icon
                    i.mdi.mdi-file-upload
                  span.file-label Choose CSV file...
                span.file-name#csv-file-name No file selected

        #csv-parse-error(style="display:none")

        #csv-preview(style="display:none")
          .box
            h5.title.is-5 Import Preview
            #csv-preview-content

          .field
            button.button.is-link#csv-import-btn
              span.icon
                i.mdi.mdi-database-import
              span Import Scores

        #csv-result(style="display:none")

  #method-server(style="display:none")
    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-database-import
          | Migrate Scores from Another Server
      .card-content
        .content
          p Import scores from another Asphyxia server's savedata folder. Select the folder containing #[code core.db] and #[code sdvx@asphyxia.db].
        .notification.is-warning.is-light
          p This feature is only compatible with servers using the #[a(href="https://github.com/22vv0/asphyxia_plugins" target="_blank") 22vv0/asphyxia_plugins] SDVX plugin or forks derived from it. Other SDVX plugins may use a different database format.

        #migrate-step-1
          .field
            .file.has-name.is-fullwidth
              label.file-label
                input.file-input(type="file" id="migrate-folder-input" webkitdirectory directory multiple)
                span.file-cta
                  span.file-icon
                    i.mdi.mdi-folder-open
                  span.file-label Choose savedata folder...
                span.file-name#migrate-folder-name No folder selected

        #migrate-parse-error(style="display:none")

        #migrate-step-2(style="display:none")
          .notification.is-success.is-light#migrate-files-found

          .field
            label.label Source Profile
            .control
              .select.is-fullwidth
                select#migrate-profile-select
                  option(value="" disabled selected) Select a profile...

          #migrate-preview(style="display:none")
            .box
              h5.title.is-5 Import Preview
              #migrate-preview-content

            .field
              button.button.is-link#migrate-import-btn
                span.icon
                  i.mdi.mdi-database-import
                span Import Scores

        #migrate-result(style="display:none")

div(hidden id='data-pass-scores') !{JSON.stringify(scores)}

script(src="static/asset/js/tachi.js")
script(src="static/asset/js/import.js")
//- inline script extracted to import.js
