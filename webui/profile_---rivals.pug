//DATA//
  rivals: DB.Find(refid, { collection: 'rival' })
  yourprofile: DB.Find(refid, { collection: 'profile' })
  profiles: DB.Find(null, { collection: 'profile' })
-
link(rel="stylesheet" href="static/asset/css/datatables.css")
div
  // Inline status banner for add/remove feedback. Hidden until rivals.js
  // populates it so the page doesn't open with a stale notification.
  div#rival-status-banner(style="display:none")

  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Add rival
    .card-content
      h5 Game
      .field
        .control
          .select.is-fullwidth
            select.select(id="version_select")
      h5 Profile
      .field
        .control
          .select.is-fullwidth
            select.select(id="profilelist")
              option(value=0) Choose profile
      .field
        button.button.is-primary(type="submit" id="addrival")
          span(id="rival-button") Add Rival

  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-multiple
        | Your Rivals
    .card-content
      p#rivals-empty.has-text-grey(style="display:none") No rivals selected for this version yet.
      table.table.is-fullwidth(id="rivals-list-table" style="display:none")
        thead
          tr
            th SDVX ID
            th Name
            th Mutual
            th(style="width:1%")
        tbody#rivals-list-body

  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Rival Score Comparison
    .card-content
      h5 Select rival to compare with:
      .field
        .control
          .select.is-fullwidth
            select.select(id="rivallist")
              option(value=0) Choose rival

      table.table(id="scorecompare" style="width:100%")
        thead
          tr
            th ID
            th Song
            th Difficulty
            th Your Score
            th Rival's Score
            th Time
        tbody

//div(hidden id='data-pass') !{JSON.stringify(profile)}
div(hidden id='rivals-pass') !{JSON.stringify(rivals)}
div(hidden id='profile-pass') !{JSON.stringify(yourprofile)}
div(hidden id='profiles-pass') !{JSON.stringify(profiles)}
script(src="static/asset/js/rivals.js")
script(src="static/asset/js/datatables.js")