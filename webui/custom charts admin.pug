-
link(rel="stylesheet" href="static/asset/css/datatables.css")
link(rel="stylesheet" href="static/asset/css/customcharts.css")
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-clipboard-check
        | Nominations Queue
    .card-content
      .buttons.are-small.mb-3#nominations-bulk-actions
        button.button.is-info#bulk-test-btn
          span.icon
            i.mdi.mdi-test-tube
          span Test All
        button.button.is-success#bulk-approve-btn
          span.icon
            i.mdi.mdi-check-all
          span Approve All
        button.button.is-danger#bulk-reject-btn
          span.icon
            i.mdi.mdi-close-thick
          span Reject All
      #nominations-queue
        p.has-text-grey Loading nominations...

  .notification.is-warning.is-light.mt-5
    p
      strong Music ID limit:
      |  The game crashes with IDs >= 3072. Custom charts are assigned IDs starting at 2800, giving a maximum of
      strong  271
      |  custom charts. If you need more slots, use a lower starting ID in the plugin config.

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-playlist-plus
        | Direct Approve from Nautica
    .card-content
      .notification.is-info.is-light
        p Browse charts from #[a(href="https://ksm.dev" target="_blank") Nautica (ksm.dev)] and approve them directly (bypassing the nomination pipeline).

      h5.title.is-5 Browse Nautica
      .field.is-grouped
        .control
          input.input.is-small#nautica-search(type="text" placeholder="Search by title, artist or effector..." style="width:300px")
        .control
          button.button.is-small#admin-prev-btn
            span.icon.is-small
              i.mdi.mdi-chevron-left
        .control
          input.input.is-small#admin-page-input(type="number" min="1" value="1" style="width:70px;text-align:center")
        .control
          span.is-size-7#admin-page-total(style="line-height:30px") / 1
        .control
          button.button.is-small#admin-next-btn
            span.icon.is-small
              i.mdi.mdi-chevron-right
        .control(style="margin-left:auto")
          span.is-size-7(style="line-height:30px") Powered by #[a(href="https://ksm.dev" target="_blank") ksm.dev]
      p.help
        span.icon.is-small(style="vertical-align:middle")
          i.mdi.mdi-information-outline
        |  Tip: use #[code level:13] or #[code levels:13,14,15] to filter by chart level.

      #nautica-results

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-check-all
        | Curated Charts
    .card-content
      .buttons.are-small.mb-3
        button.button.is-warning#bulk-reconvert-btn(title="Re-run VoxCharger on every ready/error chart. Re-downloads source ZIPs and overwrites converted files.")
          span.icon
            i.mdi.mdi-refresh
          span Reconvert All (VoxCharger)
      #curated-list
        p.has-text-grey Loading curated charts...

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-google-drive
        | Google Drive Integration
    .card-content
      p.mb-3 Authorize this server to upload converted charts to your Google Drive. Converted chart zips will be stored in the configured Drive folder and served directly from Google's CDN, bypassing your upload bandwidth.
      p.help.mb-3
        | Before clicking: set the OAuth Client ID, Client Secret, and Drive Folder ID in the plugin settings. The OAuth client must have
        | #[code http://localhost:8083/api/drive-oauth-callback] (or your actual server URL) as an Authorized redirect URI.
      a.button.is-link(href="/api/drive-oauth-start" target="_blank")
        span.icon
          i.mdi.mdi-login
        span Authorize with Google Drive

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-delete-clock
        | Deleted Charts
    .card-content
      p.help
        span.icon.is-small(style="vertical-align:middle")
          i.mdi.mdi-information-outline
        |  Deleted charts are excluded from the Nautica browse results above so they don't reappear.
      #deleted-list
        p.has-text-grey Loading deleted charts...

script(src="static/asset/js/nautica.js")
