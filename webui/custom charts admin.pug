-
link(rel="stylesheet" href="static/asset/css/datatables.css")
link(rel="stylesheet" href="static/asset/css/customcharts.css")
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-clipboard-check
        | Nominations Queue
    .card-content
      .buttons.are-small.mb-3#nominations-bulk-actions
        button.button.is-info#bulk-test-btn
          span.icon
            i.mdi.mdi-test-tube
          span Test All
        button.button.is-success#bulk-approve-btn
          span.icon
            i.mdi.mdi-check-all
          span Approve All
        button.button.is-danger#bulk-reject-btn
          span.icon
            i.mdi.mdi-close-thick
          span Reject All
      #nominations-queue
        p.has-text-grey Loading nominations...

  .notification.is-warning.is-light.mt-5
    p
      strong Music ID limit:
      |  The game crashes with IDs >= 3072. Custom charts are assigned IDs starting at 2800, giving a maximum of
      strong  271
      |  custom charts. If you need more slots, use a lower starting ID in the plugin config.

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-check-all
        | Curated Charts
    .card-content
      .buttons.are-small.mb-3
        button.button.is-warning#bulk-reconvert-btn(title="Re-run conversion on every ready/error chart. Re-downloads source ZIPs and overwrites converted files.")
          span.icon
            i.mdi.mdi-refresh
          span Reconvert All
        button.button.is-info#curated-export-btn(title="Download the full curated chart list as JSON so it can be re-imported on another server.")
          span.icon
            i.mdi.mdi-download
          span Export List
        button.button.is-info.is-light#curated-import-btn(title="Upload a previously-exported JSON. New entries are added with status 'pending'; existing charts are left untouched.")
          span.icon
            i.mdi.mdi-upload
          span Import List
        input#curated-import-file(type="file" accept=".json,application/json" style="display:none")
      .field.mb-3
        .control.has-icons-left
          input.input.is-small#curated-search(type="text" placeholder="Filter by title, artist, ID…" style="max-width:360px")
          span.icon.is-small.is-left
            i.mdi.mdi-magnify
      #curated-list
        p.has-text-grey Loading curated charts...

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-google-drive
        | Google Drive Integration
    .card-content
      p.mb-3 Authorize this server to upload converted charts to your Google Drive. Converted chart zips will be stored in the configured Drive folder and served directly from Google's CDN, bypassing your upload bandwidth.
      p.help.mb-3
        | Before clicking: set the OAuth Client ID, Client Secret, and Drive Folder ID in the plugin settings. The OAuth client must have
        | #[code http://localhost:8083/api/drive-oauth-callback] (or your actual server URL) as an Authorized redirect URI.
      a.button.is-link(href="/api/drive-oauth-start" target="_blank")
        span.icon
          i.mdi.mdi-login
        span Authorize with Google Drive

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-delete-clock
        | Deleted Charts
    .card-content
      p.help
        span.icon.is-small(style="vertical-align:middle")
          i.mdi.mdi-information-outline
        |  Deleted charts are excluded from the Nautica browse results above so they don't reappear.
      #deleted-list
        p.has-text-grey Loading deleted charts...

script(src="static/asset/js/nautica.js")
