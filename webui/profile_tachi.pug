//DATA//
  scores: DB.Find(refid, { collection: 'music' })
-
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-swap-horizontal
        | Tachi Score Sync
    .card-content
      .content
        p Synchronize your SDVX scores with #[a(href="https://kamai.tachi.ac" target="_blank") Kamaitachi].

      #tachi-status
        .notification.is-info.is-light
          span.icon
            i.mdi.mdi-loading.mdi-spin
          |  Checking Tachi authorization status...

      #tachi-not-authorized(style="display:none")
        .notification(style="background-color:rgba(255,183,77,0.15);color:#ffb74d;")
          p You are not yet authorized with Tachi. Click the button below to connect your account.
        .field
          button.button.is-link#tachi-authorize-btn
            span.icon
              i.mdi.mdi-link
            span Authorize with Tachi

      #tachi-authorized(style="display:none")
        .notification.is-success.is-light
          span.icon
            i.mdi.mdi-check-circle
          |  Connected to Tachi
        .field.is-grouped.is-grouped-multiline
          .control
            button.button.is-link#tachi-sync-btn
              span.icon
                i.mdi.mdi-sync
              span Synchronize
          .control
            button.button.is-primary.is-outlined#tachi-upload-btn
              span.icon
                i.mdi.mdi-upload
              span Export to Tachi
          .control
            button.button.is-info.is-outlined#tachi-import-btn
              span.icon
                i.mdi.mdi-download
              span Import from Tachi
          .control
            button.button.is-info.is-outlined#tachi-preview-btn
              span.icon
                i.mdi.mdi-eye
              span Preview Export
          .control
            button.button.is-danger.is-outlined#tachi-disconnect-btn
              span.icon
                i.mdi.mdi-link-off
              span Disconnect

      #tachi-result(style="display:none")
        .card.mt-4
          .card-header
            p.card-header-title Import Result
          .card-content
            #tachi-result-content

div(hidden id='data-pass-scores') !{JSON.stringify(scores)}

script.
  (function() {
    var TACHI_CLIENT_ID = '';
    var TACHI_AUTH_URL = '';

    fetch('/tachi/config')
      .then(function(r) { return r.json(); })
      .then(function(cfg) {
        TACHI_CLIENT_ID = cfg.clientId || '';
        TACHI_AUTH_URL = 'https://kamai.tachi.ac/oauth/request-auth?clientID=' + TACHI_CLIENT_ID;
        if (!TACHI_CLIENT_ID) {
          document.getElementById('tachi-status').style.display = 'none';
          document.getElementById('tachi-not-authorized').style.display = '';
          document.getElementById('tachi-not-authorized').innerHTML =
            '<div class="notification is-warning is-light">Tachi Client ID is not configured. Set it in the Asphyxia settings page.</div>';
        }
      });

    var music_db = null;
    var music_db_loaded = false;
    var music_db_error = false;
    $.getJSON("static/asset/json/music_db.json")
      .done(function(json) {
        music_db = json;
        music_db_loaded = true;
        console.log('music_db loaded, entries:', music_db["mdb"]["music"].length);
      })
      .fail(function(jqxhr, textStatus, error) {
        music_db_error = true;
        console.error('Failed to load music_db.json:', textStatus, error);
      });

    function getSongName(musicid) {
      if (!music_db) return "(DB not loaded)";
      var result = music_db["mdb"]["music"].filter(function(obj) { return obj["id"] == musicid; });
      if (result.length == 0) return "Custom Song";
      return result[0]["info"]["title_name"];
    }

    // Clear type to Tachi lamp mapping
    // SDVX EG (version 6): 0=none, 1=played, 2=clear, 3=excessive, 4=uc, 5=puc, 6=mxv
    // SDVX Nabla (version 7+): 0=none, 1=played, 2=clear, 3=excessive, 4=mxv, 5=uc, 6=puc
    var CLEAR_TO_LAMP_EG = {
      1: 'FAILED',
      2: 'CLEAR',
      3: 'EXCESSIVE CLEAR',
      4: 'ULTIMATE CHAIN',
      5: 'PERFECT ULTIMATE CHAIN',
      6: 'EXCESSIVE CLEAR'
    };


    function getDifficulty(musicid, type) {
      if (type === 0) return 'NOV';
      if (type === 1) return 'ADV';
      if (type === 2) return 'EXH';
      if (type === 4) return 'MXM';
      if (type === 5) return 'ULT';
      if (type === 3) {
        if (!music_db) return 'MXM';
        var result = music_db["mdb"]["music"].filter(function(obj) { return obj["id"] == musicid; });
        if (result.length == 0) return 'MXM';
        var inf_ver = String(result[0]["info"]["inf_ver"] || "0");
        switch (inf_ver) {
          case "2": return "INF";
          case "3": return "GRV";
          case "4": return "HVN";
          case "5": return "VVD";
          case "6": return "XCD";
          case "0": default: return "MXM";
        }
      }
      return null;
    }

    function checkStatus() {
      fetch('/tachi/status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          document.getElementById('tachi-status').style.display = 'none';
          if (data.authorized) {
            document.getElementById('tachi-authorized').style.display = '';
            document.getElementById('tachi-not-authorized').style.display = 'none';
          } else {
            document.getElementById('tachi-not-authorized').style.display = '';
            document.getElementById('tachi-authorized').style.display = 'none';
          }
        })
        .catch(function() {
          document.getElementById('tachi-status').innerHTML =
            '<div class="notification is-danger is-light">Failed to check Tachi status.</div>';
        });
    }

    checkStatus();

    window.addEventListener('message', function(event) {
      if (event.data && event.data.type === 'tachi-auth' && event.data.code) {
        fetch('/tachi/exchange', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: event.data.code })
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              checkStatus();
            } else {
              document.getElementById('tachi-status').style.display = '';
              document.getElementById('tachi-status').innerHTML =
                '<div class="notification is-danger is-light">Authorization failed: ' + (data.description || 'Unknown error') + '</div>';
            }
          });
      }
    });

    document.getElementById('tachi-authorize-btn').addEventListener('click', function() {
      window.open(TACHI_AUTH_URL, 'tachi_auth', 'width=600,height=700');
    });

    document.getElementById('tachi-disconnect-btn').addEventListener('click', function() {
      if (!confirm('Disconnect from Tachi?')) return;
      fetch('/tachi/disconnect', { method: 'POST' })
        .then(function() { checkStatus(); });
    });

    function buildTachiScores() {
      var scoresRaw = JSON.parse(document.getElementById('data-pass-scores').textContent);
      var versionCounts = {};
      for (var i = 0; i < scoresRaw.length; i++) {
        var v = scoresRaw[i].version;
        versionCounts[v] = (versionCounts[v] || 0) + 1;
      }

      var tachiScores = [];
      for (var i = 0; i < scoresRaw.length; i++) {
        var s = scoresRaw[i];
        if (s.version !== 6) continue;
        var lamp = CLEAR_TO_LAMP_EG[s.clear];
        if (!lamp) continue;
        var diff = getDifficulty(s.mid, s.type);
        if (!diff) continue;

        var timeAchieved = null;
        if (s.updatedAt) {
          timeAchieved = new Date(s.updatedAt).getTime();
        } else if (s.createdAt) {
          timeAchieved = new Date(s.createdAt).getTime();
        }

        tachiScores.push({
          score: s.score,
          lamp: lamp,
          matchType: 'sdvxInGameID',
          identifier: String(s.mid),
          difficulty: diff,
          timeAchieved: timeAchieved,
          _songName: getSongName(s.mid)
        });
      }
      return { tachiScores: tachiScores, totalRaw: scoresRaw.length, versionCounts: versionCounts };
    }

    document.getElementById('tachi-preview-btn').addEventListener('click', function() {
      if (music_db_error) {
        showResult('danger', '<strong>Failed to load song database (music_db.json).</strong> Song names will not be available. Check the browser console for details.');
      } else if (!music_db_loaded) {
        showResult('warning', '<strong>Song database is still loading...</strong> Please wait a moment and try again.');
        return;
      }
      var result = buildTachiScores();
      var html = '<p><strong>Raw scores in DB:</strong> ' + result.totalRaw + '</p>';
      html += '<p><strong>Scores per version:</strong> ';
      for (var v in result.versionCounts) {
        html += 'v' + v + ': ' + result.versionCounts[v] + ' ';
      }
      html += '</p>';
      html += '<p><strong>Exceed Gear (v6) scores to send:</strong> ' + result.tachiScores.length + '</p>';
      if (result.tachiScores.length > 0) {
        html += '<details open><summary>First 20 scores</summary>';
        html += '<div style="max-height:400px;overflow:auto;">';
        html += '<table class="table is-narrow is-fullwidth is-striped" style="font-size:0.8em;">';
        html += '<thead><tr><th>ID</th><th>Song Name</th><th>Difficulty</th><th>Score</th><th>Lamp</th></tr></thead><tbody>';
        var preview = result.tachiScores.slice(0, 20);
        for (var i = 0; i < preview.length; i++) {
          var s = preview[i];
          html += '<tr><td>' + s.identifier + '</td><td>' + s._songName + '</td><td>' + s.difficulty + '</td><td>' + s.score + '</td><td>' + s.lamp + '</td></tr>';
        }
        html += '</tbody></table></div></details>';
        html += '<details><summary>All ' + result.tachiScores.length + ' scores (JSON)</summary>';
        html += '<pre style="max-height:400px;overflow:auto;font-size:0.75em;background:#1a1a1e;color:#ddd;padding:0.5em;border-radius:4px;white-space:pre-wrap;">';
        var exportData = result.tachiScores.map(function(s) { var c = Object.assign({}, s); delete c._songName; return c; });
        html += JSON.stringify({ meta: { game: "sdvx", playtype: "Single", service: "Asphyxia" }, scores: exportData }, null, 2);
        html += '</pre></details>';
      }
      showResult('info', html);
    });

    document.getElementById('tachi-upload-btn').addEventListener('click', function() {
      var btn = this;
      btn.classList.add('is-loading');
      btn.disabled = true;

      var result = buildTachiScores();
      var tachiScores = result.tachiScores;

      if (tachiScores.length === 0) {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        showResult('warning', 'No Exceed Gear (v6) scores to upload. Versions found: ' + JSON.stringify(result.versionCounts));
        return;
      }

      // Strip _songName before sending to Tachi
      var cleanScores = tachiScores.map(function(s) { var c = Object.assign({}, s); delete c._songName; return c; });

      console.log('Sending ' + cleanScores.length + ' scores to Tachi');
      console.log('Sample score:', JSON.stringify(cleanScores[0]));

      fetch('/tachi/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scores: cleanScores })
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          console.log('Tachi response:', JSON.stringify(data));

          var html = '';
          if (data.success) {
            var body = data.body || {};
            html += '<p class="has-text-success"><strong>Export successful!</strong></p>';
            html += '<p>Total scores: ' + tachiScores.length + '</p>';
            if (data._totalSkipped !== undefined) {
              html += '<p>Skipped (Tachi already has equal or better): ' + data._totalSkipped + '</p>';
              html += '<p>Sent to Tachi: ' + (data._totalSent || 0) + '</p>';
            }
            if (data._totalSent === 0 && data._totalSkipped > 0) {
              html += '<p class="has-text-info">All scores on Tachi are already up to date!</p>';
            }
            if (body.scoreIDs) html += '<p>New scores on Tachi: ' + body.scoreIDs.length + '</p>';
            if (body.errors) html += '<p>Errors: ' + body.errors.length + '</p>';
            if (body.errors && body.errors.length > 0) {
              html += '<details><summary>Error details</summary><ul>';
              for (var j = 0; j < Math.min(body.errors.length, 50); j++) {
                html += '<li>' + (body.errors[j].message || JSON.stringify(body.errors[j])) + '</li>';
              }
              if (body.errors.length > 50) html += '<li>... and ' + (body.errors.length - 50) + ' more</li>';
              html += '</ul></details>';
            }
          } else {
            html += '<p class="has-text-danger"><strong>Import failed</strong></p>';
            html += '<p>' + (data.description || 'Unknown error') + '</p>';
          }
          html += '<details class="mt-3"><summary>Raw API Response</summary>';
          html += '<pre style="max-height:300px;overflow:auto;font-size:0.75em;background:#1a1a1e;color:#ddd;padding:0.5em;border-radius:4px;white-space:pre-wrap;">' + JSON.stringify(data, null, 2) + '</pre>';
          html += '</details>';
          showResult(data.success ? 'success' : 'danger', html);
        })
        .catch(function(err) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          showResult('danger', '<strong>Error:</strong> ' + err.message);
        });
    });

    // Import from Tachi: fetch best 50 PBs and save to Asphyxia DB
    function importFromTachi() {
      return fetch('/tachi/pbs')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.success) {
            return { success: false, description: data.description || 'Failed to fetch PBs from Tachi' };
          }
          if (!data.scores || data.scores.length === 0) {
            return { success: true, imported: 0, skipped: 0, message: 'No scores found on Tachi.' };
          }

          // Save all scores from Tachi
          return fetch('/tachi/save-scores', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refid: refid, scores: data.scores.map(function(s) {
              return { mid: s.mid, type: s.type, score: s.score, clear: s.clear, grade: s.grade, exscore: s.exscore, version: 6 };
            })})
          })
            .then(function(r) { return r.json(); })
            .then(function(saveResult) {
              if (!saveResult.success) {
                return { success: false, description: saveResult.description || 'Failed to save scores' };
              }
              return { success: true, imported: saveResult.saved, skipped: saveResult.skipped, scores: data.scores };
            });
        });
    }

    document.getElementById('tachi-import-btn').addEventListener('click', function() {
      var btn = this;
      btn.classList.add('is-loading');
      btn.disabled = true;

      importFromTachi()
        .then(function(result) {
          btn.classList.remove('is-loading');
          btn.disabled = false;

          if (!result.success) {
            showResult('danger', '<strong>Import failed:</strong> ' + (result.description || 'Unknown error'));
            return;
          }

          var html = '<p class="has-text-success"><strong>Import from Tachi complete!</strong></p>';
          html += '<p>Scores imported: ' + (result.imported || 0) + '</p>';
          if (result.skipped) html += '<p>Skipped (already in DB): ' + result.skipped + '</p>';
          if (result.message) html += '<p>' + result.message + '</p>';
          if (result.scores && result.scores.length > 0) {
            html += '<details><summary>Tachi PBs fetched (' + result.scores.length + ')</summary>';
            html += '<div style="max-height:300px;overflow:auto;">';
            html += '<table class="table is-narrow is-fullwidth is-striped" style="font-size:0.8em;">';
            html += '<thead><tr><th>ID</th><th>Song</th><th>Diff</th><th>Score</th><th>Lamp</th></tr></thead><tbody>';
            for (var i = 0; i < result.scores.length; i++) {
              var s = result.scores[i];
              html += '<tr><td>' + s.mid + '</td><td>' + s.songName + '</td><td>' + s.difficulty + '</td><td>' + s.score + '</td><td>' + s.lamp + '</td></tr>';
            }
            html += '</tbody></table></div></details>';
          }
          if (result.imported > 0) html += '<p class="mt-2"><em>Reload the page to see updated scores.</em></p>';
          showResult('success', html);
        })
        .catch(function(err) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          showResult('danger', '<strong>Error:</strong> ' + err.message);
        });
    });

    // Synchronize: export to Tachi + import from Tachi
    document.getElementById('tachi-sync-btn').addEventListener('click', function() {
      var btn = this;
      btn.classList.add('is-loading');
      btn.disabled = true;

      var syncHtml = '<p><strong>Synchronizing...</strong></p>';
      showResult('info', syncHtml);

      // Step 1: Import from Tachi
      importFromTachi()
        .then(function(importResult) {
          // Step 2: Export to Tachi (only after import is done)
          var result = buildTachiScores();
          var cleanScores = result.tachiScores.map(function(s) { var c = Object.assign({}, s); delete c._songName; return c; });

          var exportPromise;
          if (cleanScores.length > 0) {
            exportPromise = fetch('/tachi/import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ scores: cleanScores })
            }).then(function(r) { return r.json(); });
          } else {
            exportPromise = Promise.resolve({ success: true, body: { scoreIDs: [], errors: [] }, _skipped: true });
          }

          return exportPromise.then(function(exportResult) {
            btn.classList.remove('is-loading');
            btn.disabled = false;

            var html = '<p class="has-text-success"><strong>Synchronization complete!</strong></p>';
            html += '<hr>';

            // Import summary
            html += '<p><strong>Import from Tachi:</strong></p>';
            if (!importResult.success) {
              html += '<p class="has-text-danger">Import failed: ' + (importResult.description || 'Unknown error') + '</p>';
            } else {
              html += '<p>Scores imported: ' + (importResult.imported || 0) + '</p>';
              if (importResult.skipped) html += '<p>Skipped (already in DB): ' + importResult.skipped + '</p>';
              if (importResult.message) html += '<p>' + importResult.message + '</p>';
            }

            html += '<hr>';

            // Export summary
            html += '<p><strong>Export to Tachi:</strong></p>';
            if (exportResult._skipped) {
              html += '<p>No Exceed Gear (v6) scores to export.</p>';
            } else if (exportResult.success) {
              var ebody = exportResult.body || {};
              html += '<p>Total scores: ' + cleanScores.length + '</p>';
              if (exportResult._totalSkipped !== undefined) {
                html += '<p>Skipped (Tachi already has equal or better): ' + exportResult._totalSkipped + '</p>';
                html += '<p>Sent to Tachi: ' + (exportResult._totalSent || 0) + '</p>';
              }
              if (exportResult._totalSent === 0 && exportResult._totalSkipped > 0) {
                html += '<p class="has-text-info">All scores on Tachi are already up to date!</p>';
              }
              if (ebody.scoreIDs) html += '<p>New scores on Tachi: ' + ebody.scoreIDs.length + '</p>';
              if (ebody.errors && ebody.errors.length > 0) html += '<p>Errors: ' + ebody.errors.length + '</p>';
            } else {
              html += '<p class="has-text-danger">Export failed: ' + (exportResult.description || 'Unknown error') + '</p>';
            }

            if (importResult.imported > 0) html += '<p class="mt-2"><em>Reload the page to see updated scores.</em></p>';
            showResult('success', html);
          });
        })
        .catch(function(err) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          showResult('danger', '<strong>Sync error:</strong> ' + err.message);
        });
    });

    function showResult(type, html) {
      var resultDiv = document.getElementById('tachi-result');
      var contentDiv = document.getElementById('tachi-result-content');
      resultDiv.style.display = '';
      contentDiv.innerHTML = '<div class="notification is-' + type + ' is-light">' + html + '</div>';
    }
  })();
