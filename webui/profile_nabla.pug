//DATA//
  scores: DB.Find(refid, { collection: 'music', version: 7 })
-
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-wrench
        | Nabla Tools
    .card-content
      .content
        p Tools for managing your SDVX Nabla (v7) scores.

      .box
        h5.title.is-5 Recalculate Volforce
        p.
          Recalculates all version 7 volforce values using the sub-level chart ratings
          from #[code music_db.json]. This corrects values that were originally computed
          with integer levels during migration.

        .level
          .level-left
            .level-item
              span.tag.is-info.is-medium
                span.icon
                  i.mdi.mdi-music-note
                span#nabla-score-count ...

        .field
          button.button.is-warning#nabla-recalc-btn
            span.icon
              i.mdi.mdi-calculator
            span Recalculate Volforce

        #nabla-result(style="display:none")

div(hidden id='data-nabla-scores') !{JSON.stringify(scores)}

script(src="static/asset/js/nabla.js")
